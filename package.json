{
  "name": "pokedex",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "5.0.5"
  }
}
